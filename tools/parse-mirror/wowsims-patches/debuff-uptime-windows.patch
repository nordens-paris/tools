+// The windows a debuff was up in a log (Debuffs.uptime_windows), by the debuff's JSON name.
+func debuffWindows(debuffs *proto.Debuffs, name string) []*proto.DebuffWindow {
+	var out []*proto.DebuffWindow
+	for _, w := range debuffs.UptimeWindows {
+		if w.Debuff == name {
+			out = append(out, w)
+		}
+	}
+	return out
+}
+
+// With windows, the aura is up only inside them (scaled to each iteration's duration) instead of
+// all fight, at full stacks from the start of each: this replaces its always-on reset and ramp-up,
+// so it goes on after ScheduledAura (deferred in applyDebuffEffects).
+func withWindows(aura *Aura, debuffs *proto.Debuffs, name string) *Aura {
+	windows := debuffWindows(debuffs, name)
+	if len(windows) == 0 {
+		return aura
+	}
+	aura.OnReset = func(aura *Aura, sim *Simulation) {
+		aura.Duration = NeverExpires
+		for _, w := range windows {
+			atShareOfFight(sim, w.Start, func(sim *Simulation) {
+				// A stronger effect of the same kind (Expose Armor over Sunder...) keeps it off.
+				aura.Activate(sim)
+				if aura.IsActive() && aura.MaxStacks > 0 {
+					aura.SetStacks(sim, aura.MaxStacks)
+				}
+			})
+			if w.End < 1 {
+				atShareOfFight(sim, w.End, aura.Deactivate)
+			}
+		}
 	}
+	return aura
+}
+
+func atShareOfFight(sim *Simulation, share float64, action func(*Simulation)) {
+	pa := sim.GetConsumedPendingActionFromPool()
+	pa.NextActionAt = time.Duration(share * float64(sim.Duration))
+	pa.Priority = ActionPriorityDOT
+	pa.OnAction = action
+	sim.AddPendingAction(pa)
 }
 
