# Warcraft Logs v1-nøgle (https://fresh.warcraftlogs.com/profile -> "V1 Client Key").
# Valgfri: uden den skal besøgende selv indtaste en nøgle under "API key".
WCL_API_KEY=
# Spilprofil (server/game.ts): tbc-anniversary, eller forever (pladsholder)
GAME=tbc-anniversary
# Overstyrer profilens Warcraft Logs-side, f.eks. classic.warcraftlogs.com
# WCL_HOST=classic.warcraftlogs.com
# Hvor sims kører: browser (standard; WebAssembly hos den besøgende) eller cli (WoWSims på serveren;
# hurtigst, når serveren kører på din egen maskine)
SIM_MODE=browser
# WoWSims' kommandolinjeværktøj, kun til SIM_MODE=cli og dev-scripts
WOWSIMS_CLI=bin/wowsimcli.exe
# Iterationer pr. sim
# SIM_ITERATIONS=2500
# Antal sims side om side med cli (standard: antal kerner minus én)
# SIM_PARALLEL=
# Opslag i timen pr. besøgende på serverens Warcraft Logs-nøgle (0 = ingen grænse)
# VISITOR_LOOKUPS_PER_HOUR=60
# Kald til Warcraft Logs på én gang (standard 8; hvert tager ~0,4 s)
# WCL_CONCURRENCY=8
# true: healer- og tank-analyser kræver den besøgendes egen Warcraft Logs-nøgle (sat på Render;
# lokalt fra). Det gamle navn HEALERS_NEED_OWN_KEY virker også.
# ROLES_NEED_OWN_KEY=false
# API-serverens port lokalt (Vite-devserveren proxyer /api dertil); hosts sætter selv PORT
API_PORT=5174
